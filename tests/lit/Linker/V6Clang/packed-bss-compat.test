# ROOTS-DAG: kept_block
# ROOTS-DAG: forced_block
# NO-GC-DAG: kept_block
# NO-GC-DAG: forced_block
# NO-GC-DAG: dead_block
# RELOCATABLE-COUNT-2: .bss.pack
# RELOCATABLE-DAG: kept_block
# RELOCATABLE-DAG: forced_block
# MIXED-WARN: V6CLANG packed output section contains unrecognized input section '.other'; using normal layout
# MIXED-DAG: 00000100 {{.*}} first_filler
# MIXED-DAG: 00000110 {{.*}} other_block
# MIXED-DAG: 00000120 {{.*}} late_anchor
# BROAD-DAG: 0000010a {{.*}} first_filler
# BROAD-DAG: 0000011a {{.*}} late_anchor
# NON-V6CLANG-DAG: 000000000000010a {{.*}} non_v6clang_filler
# NON-V6CLANG-DAG: 000000000000011a {{.*}} non_v6clang_anchor
# EMPTY-DAG: ordinary_bss
# EMPTY-DAG: __bss_start
# EMPTY-DAG: __bss_end
# BOUNDS: .bss.pack NOBITS
# BOUNDS-DAG: kept_block
# BOUNDS-DAG: ordinary_bss
# BOUNDS-DAG: __bss_start
# BOUNDS-DAG: __bss_end

#--- roots.ld
ENTRY(_start)
SECTIONS {
  . = 0x100;
  .text : { *(.text*) }
  .bss.pack : {
    KEEP(*keep.o(.bss.pack))
    *(.bss.pack)
  }
}

#--- simple.ld
ENTRY(_start)
SECTIONS {
  . = 0x100;
  .text : { *(.text*) }
  .bss.pack : { *(.bss.pack) }
}

#--- mixed.ld
SECTIONS {
  _start = 0;
  .bss.pack 0x100 : { *(.bss.pack) *(.other) *(.bss.pack.align) }
}

#--- broad.ld
SECTIONS {
  _start = 0;
  .bss 0x10a : { *(.bss*) }
  .other : { *(.other) }
}

#--- non-v6clang.ld
SECTIONS {
  _start = 0;
  .bss.pack 0x10a : { *(.bss.pack) *(.bss.pack.align) }
}

#--- main.s
.section .text._start,"ax",@progbits
.globl _start
_start:
  nop

#--- keep.s
.section .bss.pack,"aw",@nobits
.globl kept_block
kept_block:
  .zero 16

#--- force.s
.section .bss.pack,"aw",@nobits
.globl forced_block
forced_block:
  .zero 17

#--- dead.s
.section .bss.pack,"aw",@nobits
.globl dead_block
dead_block:
  .zero 18

#--- mixed.s
.section .bss.pack,"aw",@nobits
.globl first_filler
first_filler:
  .zero 16

.section .other,"aw",@nobits
.globl other_block
other_block:
  .zero 16

.section .bss.pack.align,"aw",@nobits
.globl late_anchor
late_anchor:
  .zero 16

#--- non-v6clang.s
.section .bss.pack,"aw",@nobits
.globl non_v6clang_filler
non_v6clang_filler:
  .zero 16

.section .bss.pack.align,"aw",@nobits
.globl non_v6clang_anchor
non_v6clang_anchor:
  .zero 16

#--- ordinary.s
.section .bss,"aw",@nobits
.globl ordinary_bss
ordinary_bss:
  .zero 10
