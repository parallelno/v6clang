# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/progbits.s -o %t/progbits.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/progbits.elf %t/progbits.o 2>&1 | FileCheck %s --check-prefix=PROGBITS
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/nonwrite.s -o %t/nonwrite.o
# RUN: llvm-objcopy --rename-section .invalid=.bss.pack %t/nonwrite.o %t/nonwrite-renamed.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/nonwrite.elf %t/nonwrite-renamed.o 2>&1 | FileCheck %s --check-prefix=NONWRITE
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/exec.s -o %t/exec.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/exec.elf %t/exec.o 2>&1 | FileCheck %s --check-prefix=FLAGS
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/tls.s -o %t/tls.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/tls.elf %t/tls.o 2>&1 | FileCheck %s --check-prefix=FLAGS
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/merge.s -o %t/merge.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/merge.elf %t/merge.o 2>&1 | FileCheck %s --check-prefix=MERGE
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/aligned.s -o %t/aligned.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/aligned.elf %t/aligned.o 2>&1 | FileCheck %s --check-prefix=ALIGN
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/empty.s -o %t/empty.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/empty.elf %t/empty.o 2>&1 | FileCheck %s --check-prefix=EMPTY
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/window.s -o %t/window.o
# RUN: not ld.lld -m elf32v6clang -T %t/layout.ld -o %t/window.elf %t/window.o 2>&1 | FileCheck %s --check-prefix=WINDOW
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/overflow.s -o %t/overflow.o
# RUN: not ld.lld -m elf32v6clang -T %t/overflow.ld -o %t/overflow.elf %t/overflow.o 2>&1 | FileCheck %s --check-prefix=OVERFLOW

# PROGBITS: packed V6CLANG section must have type SHT_NOBITS
# NONWRITE: packed V6CLANG section must have SHF_ALLOC and SHF_WRITE flags
# FLAGS: packed V6CLANG section has incompatible ELF flags
# MERGE: writable SHF_MERGE section is not supported
# ALIGN: packed V6CLANG section must have alignment 1
# EMPTY: packed V6CLANG section must not be empty
# WINDOW: .bss.pack.window section exceeds 256 bytes
# OVERFLOW: V6CLANG packed section exceeds the 16-bit address space

#--- layout.ld
SECTIONS {
  _start = 0;
  .bss.pack : { *(.bss.pack.align) *(.bss.pack.window) *(.bss.pack) }
}

#--- overflow.ld
SECTIONS {
  _start = 0;
  .bss.pack 0xff00 : { *(.bss.pack) }
}

#--- progbits.s
.section .bss.pack,"aw",@progbits
.globl bad
bad:
  .zero 1

#--- nonwrite.s
.section .invalid,"a",@nobits
.globl bad
bad:
  .zero 1

#--- exec.s
.section .bss.pack,"awx",@nobits
.globl bad
bad:
  .zero 1

#--- tls.s
.section .bss.pack,"awT",@nobits
.globl bad
bad:
  .zero 1

#--- merge.s
.section .bss.pack,"awM",@nobits,1
.globl bad
bad:
  .zero 1

#--- aligned.s
.section .bss.pack,"aw",@nobits
.p2align 1
.globl bad
bad:
  .zero 1

#--- empty.s
.section .bss.pack,"aw",@nobits
.globl bad
bad:

#--- window.s
.section .bss.pack.window,"aw",@nobits
.globl bad
bad:
  .zero 257

#--- overflow.s
.section .bss.pack,"aw",@nobits
.globl bad
bad:
  .zero 257
