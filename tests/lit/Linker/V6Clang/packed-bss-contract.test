# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/main.s -o %t/main.o
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/blocks-a.s -o %t/blocks-a.o
# RUN: llvm-mc -filetype=obj -triple=i8080-unknown-v6clang %t/blocks-b.s -o %t/blocks-b.o
# RUN: llvm-readobj --sections --symbols --relocations %t/blocks-a.o | \
# RUN:   FileCheck %s --check-prefix=OBJECT
# RUN: llvm-readelf --relocations %t/blocks-a.o | \
# RUN:   FileCheck %s --check-prefix=RELOCS
# RUN: ld.lld -m elf32v6clang --gc-sections -T %t/layout.ld -o %t/out.elf \
# RUN:   %t/main.o %t/blocks-a.o %t/blocks-b.o
# RUN: llvm-readelf --wide --sections --symbols %t/out.elf | \
# RUN:   FileCheck %s --check-prefix=GC --implicit-check-not=dead_same_object \
# RUN:   --implicit-check-not=dead_other_object

## LLVM MC's unique,N discriminator creates independent ELF section headers;
## it is not part of the visible section name.
# OBJECT: Index: 3
# OBJECT-NEXT: Name: .bss.pack
# OBJECT-NEXT: Type: SHT_NOBITS
# OBJECT: SHF_ALLOC
# OBJECT-NEXT: SHF_WRITE
# OBJECT: Size: 11
# OBJECT: AddressAlignment: 1
# OBJECT: Index: 4
# OBJECT-NEXT: Name: .bss.pack
# OBJECT-NEXT: Type: SHT_NOBITS
# OBJECT: SHF_ALLOC
# OBJECT-NEXT: SHF_WRITE
# OBJECT: Size: 13
# OBJECT: AddressAlignment: 1
# OBJECT-DAG: Name: keep_same_object
# OBJECT-DAG: Name: dead_same_object
# RELOCS: There are no relocations in this file.

# GC: .bss.pack NOBITS
# GC-DAG: keep_same_object
# GC-DAG: keep_other_object

#--- layout.ld
ENTRY(_start)
SECTIONS {
  . = 0x100;
  .text : { *(.text*) }
  .bss.pack : { *(.bss.pack) }
}

#--- main.s
.section .text._start,"ax",@progbits
.globl _start
_start:
  .short keep_same_object
  .short keep_other_object

#--- blocks-a.s
.section .bss.pack,"aw",@nobits,unique,1
.globl keep_same_object
keep_same_object:
  .zero 11

.section .bss.pack,"aw",@nobits,unique,2
.globl dead_same_object
dead_same_object:
  .zero 13

#--- blocks-b.s
.section .bss.pack,"aw",@nobits,unique,1
.globl keep_other_object
keep_other_object:
  .zero 17

.section .bss.pack,"aw",@nobits,unique,2
.globl dead_other_object
dead_other_object:
  .zero 19
