# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# RUN: llvm-mc -triple=i8080-unknown-v6clang -filetype=obj -o %t/valid.o %t/valid.s
# RUN: llvm-readelf -r %t/valid.o | FileCheck %s --check-prefix=RELOC
# RUN: lld -flavor gnu -m elf32v6clang -e _start --defsym=target=0xffffffff -o %t/valid.elf %t/valid.o
# RUN: llvm-readelf -x .text %t/valid.elf | FileCheck %s --check-prefix=BOUNDARY
# RUN: not llvm-mc -triple=i8080-unknown-v6clang -filetype=obj -o %t/malformed.o %t/malformed.s 2>&1 | FileCheck %s --check-prefix=MALFORMED

# RELOC: R_V6CLANG_32
# BOUNDARY: ffffffff
# MALFORMED: error: unknown relocation name

# ELF32 relocation entries cannot encode an out-of-range R_V6CLANG_32 value: both
# r_offset/r_info and r_addend are 32-bit fields. This boundary test verifies
# that the complete unsigned 32-bit bit pattern is preserved; malformed names
# are rejected by the V6CLANG MC backend before an invalid object is produced.

#--- valid.s
.text
.globl _start
_start:
  .long 0
  .reloc 0, R_V6CLANG_32, target

#--- malformed.s
.text
.globl _start
_start:
  .long 0
  .reloc 0, R_V6CLANG_99, target